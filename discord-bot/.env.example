# Discord Bot Token (Discord Developer Portal)
DISCORD_TOKEN=dein_token_hier

# Minecraft Server RCON
RCON_HOST=deine_server_ip
RCON_PORT=25575
RCON_PASSWORD=dein_rcon_passwort

# Discord Kanal ID vom Whitelist-Kanal (Rechtsklick auf Kanal -> ID kopieren)
WHITELIST_CHANNEL_ID=123456789012345678

# Discord Kanal ID vom Admin-Log-Kanal
ADMIN_LOG_CHANNEL_ID=123456789012345678

# Kanal für die Live-Liste der gewhitelisteten Spieler.
# Leer lassen -> die Liste landet im Whitelist-Kanal.
WHITELIST_LIST_CHANNEL_ID=

# Kanal für das Admin-Panel (Dimensionen schalten, kicken, bannen).
# Leer lassen -> das Panel landet im Admin-Log-Kanal.
ADMIN_PANEL_CHANNEL_ID=

# Discord Rollen ID der "Whitelisted" Rolle (Rechtsklick auf Rolle -> ID kopieren)
WHITELIST_ROLE_ID=123456789012345678

# Testmodus: RCON wird übersprungen, alles andere funktioniert normal (true/false)
TEST_MODE=false
